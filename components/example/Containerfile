# Example component Containerfile (design: ../../docs/multi-component.md).
#
# Template for a component's OWN repo. It builds on the platform's published
# common-dev / common-runtime images: install this component's delta on top of
# the shared /opt/cpan-common, prune the files common already provides (safe —
# the BOM gate pins shared distributions to the same version), then ship a
# runtime that is common-runtime + this delta + the app.
#
# In a real component repo the FROM images are pinned by digest to a published
# platform version; here they default to locally-built tags so `make
# build-example-component` can build it end to end against this repo's own
# common-dev / common-runtime.

ARG COMMON_IMAGE=myapp
ARG COMMON_DEV_TAG=common-dev
ARG COMMON_RUNTIME_TAG=common-runtime

# ---- build: install the component's delta on top of common, then prune ----
# hadolint ignore=DL3006
FROM ${COMMON_IMAGE}:${COMMON_DEV_TAG} AS build

WORKDIR /opt/component-install
# The bundle (from `make bundle-component`) is delta-only and already contains
# cpanfile + vendor/cache. install-component-layered (baked into common-dev)
# seeds /opt/cpan-component from /opt/cpan-common, installs the delta, and
# prunes the shared files back out — leaving a delta-only component layer.
COPY bundle-latest.tar.gz ./component-bundle.tar.gz
# hadolint ignore=DL3003
RUN tar xzf component-bundle.tar.gz \
    && install-component-layered . /opt/cpan-common /opt/cpan-component \
    && rm -rf /opt/component-install ~/.perl-cpm

# ---- runtime: common-runtime + the pruned delta + the app ----
# hadolint ignore=DL3006
FROM ${COMMON_IMAGE}:${COMMON_RUNTIME_TAG}

COPY --from=build /opt/cpan-component /opt/cpan-component
ENV PERL5LIB="/opt/cpan-component/lib/perl5:${PERL5LIB}"

WORKDIR /app
COPY app/ ./

CMD ["/opt/perl/bin/perl", "app.pl"]

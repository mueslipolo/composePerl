# Containerfile.deps - Bundle regeneration workflow
#
# Layers Carton on top of <image>:dev-tools (which already has the full XS
# toolchain and Oracle SDK) to generate the offline CPAN bundle. Invoked by
# scripts/deps.sh for `make bundle` and `make update` / `make update-all`.
#
# Prerequisite: <image>:dev-tools must exist locally. scripts/deps.sh builds it
# from the main Containerfile (--target dev-tools) before invoking this file.
# Because dev-tools is the same layer the `dev` stage builds on, the toolchain
# package list lives in exactly one place (main Containerfile) — no drift.

# Matches whatever image name Makefile's IMAGE_NAME (default "myapp") built
# dev-tools under; deps.sh always passes this explicitly.
ARG BASE_IMAGE_NAME=myapp
FROM ${BASE_IMAGE_NAME}:dev-tools

# No proxy ARG/ENV here by design: http_proxy/https_proxy/no_proxy are
# inherited from whatever was baked into :dev-tools's image config (see the
# main Containerfile's `base` stage). deps.sh always rebuilds dev-tools with
# the current proxy args immediately before building this file, so it's
# already current — redeclaring here with no default would clobber that
# inherited value with an empty string. See docs/proxy.md.

# Carton (via cpanm fatpack). Lives only in this image, never in dev/runtime.
COPY artifacts/cpanm /opt/perl/bin/cpanm
RUN /opt/perl/bin/cpanm --notest Carton \
    || { echo "==> cpanm failed - check http_proxy/https_proxy build-args and certs/ CA trust; see docs/proxy.md" >&2; exit 1; }

WORKDIR /build

COPY cpanfile cpanfile.snapshot ./

# `carton install` rejects an empty snapshot file with "Could not parse snapshot
# file: __EOF__". Empty snapshots are legitimate (e.g. the container-build test
# workspace uses one as a placeholder for first-time resolution) — drop the
# file so carton resolves fresh from cpanfile. A real non-empty snapshot is
# always kept and used verbatim.
RUN [ -s cpanfile.snapshot ] || rm -f cpanfile.snapshot; \
    { /opt/perl/bin/carton install \
        && /opt/perl/bin/carton bundle \
        || { echo "==> carton install/bundle failed - check http_proxy/https_proxy build-args and certs/ CA trust; see docs/proxy.md" >&2; exit 1; }; } \
    && tar czf cpan-bundle.tar.gz ./vendor cpanfile cpanfile.snapshot

# Normalize line endings: treat all text files as LF in the repository,
# regardless of the checkout platform. Prevents CRLF churn from Windows editors.
* text=auto eol=lf

# Executable scripts must stay LF (shebangs break with CRLF on Linux)
*.sh text eol=lf
*.pl text eol=lf
*.pm text eol=lf
*.py text eol=lf

# Config / build files parsed line-by-line
Makefile text eol=lf
Containerfile text eol=lf
Containerfile.deps text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sha256 text eol=lf

# Binary files: never touch
*.tar.gz binary
*.png binary
*.jpg binary

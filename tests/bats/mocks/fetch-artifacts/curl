#!/usr/bin/env bash
# Mock curl for fetch-artifacts.bats. The real script makes four distinct
# kinds of curl call; this mock handles all four:
#   1. Downloads:      curl ... -o <dest> <url>                  -> writes a payload to <dest>
#   2. MetaCPAN POST:  curl ... -X POST <metacpan-url> ...        -> JSON to stdout
#   3. CHECKSUMS GET:  curl ... <cpan CHECKSUMS url>              -> Perl-struct text to stdout
#   4. Nexus upload:   curl ... -u user:pass --upload-file <f> <url> -> logs and succeeds
#
# Logs every invocation to $BATS_TEST_TMPDIR/curl.log so tests can assert on
# how many network calls actually happened (idempotent runs should make none).
#
# FETCH_MOCK_BAD_PAYLOAD=1        - downloads write random junk (tamper/corruption test)
# FETCH_MOCK_METACPAN_SHA256=xxx  - MetaCPAN lookup reports this hash instead of the
#                                   real downloaded file's hash (independent-source-
#                                   disagrees test)
# FETCH_MOCK_ARTIFACTS_DIR        - where to find the just-downloaded perl tarball when
#                                   computing the default (self-consistent) MetaCPAN hash
# FETCH_MOCK_DOWNLOAD_EXIT_CODE   - if set, a download (-o) call exits with this code
#                                   instead of succeeding (simulates a real curl
#                                   network/TLS failure, e.g. 7 or 60)

set -eu

# Logging the proxy env vars actually seen here (not just what the script
# printed) proves they reached the real downstream consumer of them.
echo "curl $* [http_proxy=${http_proxy:-} https_proxy=${https_proxy:-} no_proxy=${no_proxy:-}]" >> "${BATS_TEST_TMPDIR}/curl.log"

dest=""
url=""
is_post=0
upload_file=""
auth=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) dest="$2"; shift 2 ;;
        -X) [[ "${2:-}" == "POST" ]] && is_post=1; shift 2 ;;
        -u) auth="$2"; shift 2 ;;
        # Credentials now arrive via a curl config file (user = "user:pass")
        # instead of -u; read them back so the upload check below still proves
        # they were passed through.
        -K|--config) auth="$(sed -n 's/^user = "\(.*\)"$/\1/p' "$2")"; shift 2 ;;
        --upload-file) upload_file="$2"; shift 2 ;;
        -H|-d) shift 2 ;;
        --retry) shift 2 ;;
        -fsSL|-fSL|-fsS|-fL|-f|-s|-S|-L) shift ;;
        --*) shift ;;
        http*) url="$1"; shift ;;
        *) shift ;;
    esac
done

if [[ -n "$upload_file" ]]; then
    # Case 4: Nexus upload via --upload-file. Requires auth (-u) to be present,
    # same as a real Nexus hosted-repo write would; fails clearly otherwise so
    # a test can assert credentials were actually passed through.
    if [[ -z "$auth" ]]; then
        echo "curl: mock upload refused: no -u credentials given" >&2
        exit 22
    fi
    if [[ ! -f "$upload_file" ]]; then
        echo "curl: mock upload failed: local file not found: $upload_file" >&2
        exit 26
    fi
    exit 0
fi

if [[ -n "$dest" ]]; then
    if [[ -n "${FETCH_MOCK_DOWNLOAD_EXIT_CODE:-}" ]]; then
        echo "curl: mock network/TLS failure (exit ${FETCH_MOCK_DOWNLOAD_EXIT_CODE})" >&2
        exit "${FETCH_MOCK_DOWNLOAD_EXIT_CODE}"
    fi
    # Case 1: a download with -o. Deterministic-per-destination content so
    # idempotent re-runs (and the MetaCPAN self-check below) see stable hashes.
    final_name="$(basename "$dest")"
    final_name="${final_name%.part}"
    if [[ "${FETCH_MOCK_BAD_PAYLOAD:-0}" == "1" ]]; then
        head -c 32 /dev/urandom > "$dest"
    else
        printf 'mock-payload-for-%s\n' "$final_name" > "$dest"
    fi
    exit 0
fi

if [[ "$url" == *fastapi.metacpan.org* ]] && [[ "$is_post" == "1" ]]; then
    # Case 2: MetaCPAN independent-checksum lookup. Default: report the real
    # hash of whatever was just downloaded to FETCH_MOCK_ARTIFACTS_DIR, so the
    # happy path is self-consistent without hardcoding a version number here.
    if [[ -n "${FETCH_MOCK_METACPAN_SHA256:-}" ]]; then
        hash="${FETCH_MOCK_METACPAN_SHA256}"
    else
        hash="$(sha256sum "${FETCH_MOCK_ARTIFACTS_DIR:-/nonexistent}"/perl-*.tar.gz 2>/dev/null | head -1 | cut -d' ' -f1)"
    fi
    if [[ -z "$hash" ]]; then
        exit 22   # simulates a failed MetaCPAN request
    fi
    printf '{"checksum_sha256":"%s"}\n' "$hash"
    exit 0
fi

if [[ "$url" == *cpan.org/src/5.0/CHECKSUMS* ]]; then
    # Case 3: CHECKSUMS fallback, only reached if MetaCPAN failed. Empty by
    # default (both independent sources unavailable); tests can override.
    printf '%s' "${FETCH_MOCK_CHECKSUMS_BODY:-}"
    exit 0
fi

echo "curl mock: unrecognized invocation: $*" >&2
exit 1

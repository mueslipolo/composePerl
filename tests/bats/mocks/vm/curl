#!/usr/bin/env bash
# Mock curl for vm-bootstrap-perlbrew.bats. Logs the invocation (including
# the proxy env vars actually seen, proving they reached the real
# downstream consumer) and, when the URL matches perlbrew's installer,
# emits a harmless script. The real script downloads to a file (`-o <path>`)
# and then runs it, so this mock honors `-o` and writes there; if no `-o` is
# given it falls back to stdout.
#
# MOCK_CURL_EXIT_CODE - if set, exit with this code instead of succeeding
#                        (simulates a real curl network/TLS failure)
set -eu

echo "curl $* [http_proxy=${http_proxy:-} https_proxy=${https_proxy:-} no_proxy=${no_proxy:-}]" >> "${BATS_TEST_TMPDIR}/curl.log"

if [[ -n "${MOCK_CURL_EXIT_CODE:-}" ]]; then
    echo "curl: mock network/TLS failure (exit ${MOCK_CURL_EXIT_CODE})" >&2
    exit "${MOCK_CURL_EXIT_CODE}"
fi

# Extract the -o <path> target if present.
out_file=""
prev=""
for arg in "$@"; do
    if [[ "$prev" == "-o" ]]; then
        out_file="$arg"
    fi
    prev="$arg"
done

for arg in "$@"; do
    if [[ "$arg" == *install.perlbrew.pl* ]]; then
        if [[ -n "$out_file" ]]; then
            echo 'echo mock-perlbrew-installer-ran' > "$out_file"
        else
            echo 'echo mock-perlbrew-installer-ran'
        fi
        exit 0
    fi
done

echo "mock curl: unhandled args: $*" >&2
exit 1

# Artifacts and CPAN bundles
bundles/
artifacts/

# Local Carton files (if running locally)
.carton/
local/
vendor/

# User-provided corporate CA certs (never committed)
certs/*
!certs/.gitkeep

# Test reports
test-reports/
.claude/

# Generated locally by `make sbom` / `make security-audit` (default output paths)
/sbom.json
/security-audit.json

# Python bytecode (tests/mitm-proxy/)
__pycache__/
*.pyc

# CI-staged component bundle (copied next to the example Containerfile at build time)
components/*/bundle-*.tar.gz

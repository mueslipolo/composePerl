# Artifacts and CPAN bundles
bundles/
artifacts/

# Local Carton files (if running locally)
.carton/
local/

# User-provided corporate CA certs (never committed)
certs/*
!certs/.gitkeep

# Test reports
test-reports/
.claude/

# Generated locally by `make sbom` / `make security-audit` (default output paths)
/sbom.json
/security-audit.json
/security-audit.md

# Python bytecode (tests/mitm-proxy/)
__pycache__/
*.pyc
